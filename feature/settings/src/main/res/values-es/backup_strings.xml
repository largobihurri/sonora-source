    <string name="backup_working">Un momento…</string>

    <string name="backup_saved">Copia guardada.</string>
    <string name="backup_write_failed">No se ha podido guardar la copia. Prueba en otro sitio.</string>
    <string name="backup_unreadable">No se ha podido leer ese archivo.</string>
    <string name="backup_other_format">Ese archivo no es una copia de seguridad de Sonora.</string>
    <string name="backup_newer_version">Esta copia se hizo con una versión más reciente de Sonora. Actualiza Sonora para restaurarla.</string>
    <string name="backup_malformed">Esa copia está dañada y no se puede restaurar.</string>
