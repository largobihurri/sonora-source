    <!-- Ezarpenak › Babeskopia -->
    <string name="settings_backup">Babeskopia</string>
    <string name="backup_footer">Babeskopia batek zure zerrendak, gogokoak, ainguratutakoak, ezkutatutakoak, erreprodukzioak eta ezarpenak gordetzen ditu fitxategi bakarrean. Ez ditu zure musika-fitxategiak ez karpetetarako sarbidea barne hartzen.</string>
    <string name="backup_back_up">Egin babeskopia</string>
    <string name="backup_restore">Leheneratu</string>
    <string name="backup_last">Azken babeskopia: %1$s</string>
    <string name="backup_never">Oraindik ez dago babeskopiarik</string>
    <string name="backup_working">Itxaron…</string>

    <string name="backup_saved">Babeskopia gorde da.</string>
    <string name="backup_write_failed">Ezin izan da babeskopia gorde. Saiatu beste leku batean.</string>
    <string name="backup_unreadable">Ezin izan da fitxategi hori irakurri.</string>
    <string name="backup_other_format">Fitxategi hori ez da Sonoraren babeskopia bat.</string>
    <string name="backup_newer_version">Babeskopia hau Sonoraren bertsio berriago batekin egin zen. Eguneratu Sonora leheneratzeko.</string>
    <string name="backup_malformed">Babeskopia hori hondatuta dago eta ezin da leheneratu.</string>
    <string name="backup_restore_failed">Ezin izan da leheneratzea amaitu. Orain arte leheneratutakoa geratzen da.</string>
    <string name="backup_no_picker">Telefono honetako aplikazio batek ere ezin du fitxategirik aukeratu.</string>
    <string name="backup_ok">Ados</string>

