    <!-- Deleting copies -->
    <plurals name="duplicates_delete_title">
        <item quantity="one">Delete %1$d copy from your device?</item>
        <item quantity="other">Delete %1$d copies from your device?</item>
    </plurals>
    <string name="duplicates_delete_message">This can’t be undone. The files are deleted from your device. The copy you keep takes their place in playlists and keeps their favourites, pins and play counts.</string>
    <string name="duplicates_delete_confirm">Delete</string>
    <string name="duplicates_cancel">Cancel</string>
    <string name="duplicates_ok">OK</string>
    <string name="duplicates_access_title">Allow Deleting</string>
    <string name="duplicates_access_message">Sonora can only read the folder “%1$s”. To delete these files, choose that folder again and allow access.</string>
    <string name="duplicates_access_wrong_folder">That was a different folder. Choose “%1$s” to allow deleting.</string>
    <string name="duplicates_access_choose">Choose Folder…</string>
    <string name="duplicates_deleted_title">Copies Deleted</string>
