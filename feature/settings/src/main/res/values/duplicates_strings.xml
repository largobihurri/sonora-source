<resources>
    <!-- The "duplicates piled up" notification, on its own channel -->
    <string name="duplicates_channel_name">Duplicates</string>
    <string name="duplicates_channel_description">Tells you when many duplicate songs have piled up in your library.</string>
    <string name="duplicates_notification_title">Duplicates in Your Library</string>
    <plurals name="duplicates_notification_text">
        <item quantity="one">%1$d song has copies in your library. Tap to review it.</item>
        <item quantity="other">%1$d songs have copies in your library. Tap to review them.</item>
    </plurals>
    <!-- Settings › Duplicates: groups of copies of one song, compared side by side -->
    <string name="settings_duplicates">Duplicates</string>
    <string name="duplicates_footer">Songs that are in your library more than once: the very same file, or the same song in different files. Compare the copies, keep the best one and delete the others.</string>
    <string name="duplicates_notify">Notify When Duplicates Pile Up</string>
    <string name="duplicates_notify_footer">Sonora looks for duplicates now and then while your device is idle and charging, and tells you once 20 songs or more have copies.</string>
    <string name="duplicates_scan_again">Look for Duplicates Again</string>
    <string name="duplicates_looking">Looking for duplicates…</string>
    <string name="duplicates_checking">Comparing files… %1$s of %2$s</string>
    <string name="duplicates_failed">Couldn’t look for duplicates. Try again.</string>
    <string name="duplicates_none">No Duplicates</string>
    <plurals name="duplicates_found">
        <item quantity="one">%1$d song has copies</item>
        <item quantity="other">%1$d songs have copies</item>
    </plurals>
