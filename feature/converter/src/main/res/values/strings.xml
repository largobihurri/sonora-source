    <!-- Output folder -->
    <string name="converter_output_header">Output Folder</string>
    <string name="converter_output_choose">Choose Folder</string>
    <string name="converter_output_change">Change Folder</string>
    <string name="converter_output_none_footer">Choose a folder on your phone or USB drive. Sonora creates a “Convertidos” folder in it, with one dated folder per batch.</string>
    <!-- %1$s is the name of the chosen folder. -->
    <string name="converter_output_footer">Converted files go to “Convertidos” in %1$s, one dated folder per batch.</string>
    <!-- Spoken label of the output folder row; %1$s is the folder's name. -->
    <string name="converter_output_location">%1$s › Convertidos</string>

    <!-- Sources -->
    <string name="converter_sources_header">To Convert</string>
    <string name="converter_add_music">Add Music…</string>
    <string name="converter_browse_files">Browse Files…</string>
    <string name="converter_browse_folder">Browse Folder…</string>
    <!-- %1$s is the name of a file or folder in the list. -->
    <string name="converter_remove_source">Remove %1$s</string>
    <string name="converter_source_folder">Folder · everything inside</string>
    <string name="converter_source_file">File</string>
    <string name="converter_source_song">Song</string>
    <string name="converter_sources_footer">Add songs, albums, folders or playlists from your library. A library song replaces its original only where Sonora may write to its folder.</string>
    <string name="converter_browse_footer">Or pick files and folders on this device. Files picked one by one can’t be replaced in place; to replace originals, browse for their folder instead.</string>

    <!-- Performance -->
    <string name="converter_performance_header">Performance</string>
    <string name="converter_mode_low">Low Resources</string>
    <string name="converter_mode_normal">Normal</string>
    <string name="converter_mode_high">High Performance</string>
    <string name="converter_mode_low_description">One file at a time, with pauses. Gentle on battery and heat.</string>
    <string name="converter_mode_normal_description">Several files at once, in the background. A good balance.</string>
    <string name="converter_mode_high_description">Uses most of the processor. Fastest; the phone gets warmer.</string>
    <string name="converter_performance_footer">Quality is identical in every mode; only speed and load change. Sonora slows down by itself when the phone gets hot or Battery Saver is on.</string>

    <!-- Overwrite originals -->
    <string name="converter_overwrite">Overwrite Originals</string>
    <string name="converter_overwrite_footer">Each original is replaced by its converted file once the file has been checked. You’re also asked after the batch.</string>

