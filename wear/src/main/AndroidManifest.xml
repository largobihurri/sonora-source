<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Receiving music from the phone keeps the app in the foreground while it runs. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- The playback notification (Android 13+); playback itself does not need it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Package visibility for the Bluetooth settings page the headphones prompt opens. -->
    <queries>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
    </queries>

    <!-- Backup is off altogether: the music is large and is sent again from the phone. -->
    <application
        android:name=".SonoraWearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault"
        tools:ignore="DataExtractionRules">

        <!-- The watch app works without the phone app: songs are on the watch itself. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported for the system's media controls and headset buttons, which bind to the session. -->
        <service
            android:name=".playback.WearPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <!-- Woken by the Data Layer when the phone opens the sync channel, even if the app is not running. -->
        <service
            android:name=".sync.WatchSyncListenerService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/sonora/sync" />
            </intent-filter>
        </service>

        <!-- Keeps the app alive while songs are received; stops itself when the transfer ends. -->
        <service
            android:name=".sync.WatchReceiveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Media buttons (a headset's play) start the service when it is not running. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
