<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud backup and device transfer from Android 12. Everything is included except the DJ analysis database: its
     waveforms are recomputed from the audio, and its grids, keys and edits travel in Sonora's own backup file; and
     the translucent this device's GPU kept up with (TranslucentCeiling) and the DUB mode flag
     (SharedPreferencesDubModeSettings), which belong to the device, not the user. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="sonora-dj.db" />
        <exclude domain="database" path="sonora-dj.db-wal" />
        <exclude domain="database" path="sonora-dj.db-shm" />
        <exclude domain="database" path="sonora-dj.db-journal" />
        <exclude domain="sharedpref" path="sonora_glass_load.xml" />
        <exclude domain="sharedpref" path="sonora_dub_mode.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="sonora-dj.db" />
        <exclude domain="database" path="sonora-dj.db-wal" />
        <exclude domain="database" path="sonora-dj.db-shm" />
        <exclude domain="database" path="sonora-dj.db-journal" />
        <exclude domain="sharedpref" path="sonora_glass_load.xml" />
        <exclude domain="sharedpref" path="sonora_dub_mode.xml" />
    </device-transfer>
</data-extraction-rules>
